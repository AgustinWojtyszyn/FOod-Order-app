{
  "name": "food-order-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build --mode production && npx vite-bundle-visualizer",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "test:load": "node testing/load/test-load.js",
    "test:light": "node testing/load/test-load.js 10 5",
    "test:medium": "node testing/load/test-load.js 50 10",
    "test:heavy": "node testing/load/test-load.js 100 20",
    "audit:unlighthouse": "npx unlighthouse --config-file unlighthouse.config.mjs",
    "check:optimizations": "./testing/scripts/check-optimizations.sh",
    "deploy": "npm run build && echo 'Build completado. Listo para deployment'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.80.0",
    "clsx": "^2.1.1",
    "deno": "^2.6.8",
    "dompurify": "^3.3.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.23.24",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.553.0",
    "nodemailer": "^9.0.1",
    "react": "^19.1.1",
    "react-datepicker": "^9.0.0",
    "react-dom": "^19.1.1",
    "react-error-boundary": "^6.0.0",
    "react-feather": "^2.0.10",
    "react-hook-form": "^7.66.0",
    "react-router-dom": "^7.9.5",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/postcss": "^4.1.17",
    "@unlighthouse/cli": "^0.17.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "supabase": "^2.107.0",
    "tailwindcss": "^4.1.17",
    "terser": "^5.44.1",
    "vite": "^7.1.7",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
